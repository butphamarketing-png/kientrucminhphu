# Copy to .env.local (gitignored) or set on Vercel → Settings → Environment Variables

# Admin /adminbp
ADMINBP_USER=admin@kientrucminhphu.com
ADMINBP_PASSWORD=
ADMINBP_SECRET=

# Supabase (tạo project mới cho Kiến Trúc Minh Phú → chạy supabase/schema.sql)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (bucket gợi ý: minhphu-media)
R2_ACCOUNT_ID=
R2_BUCKET_NAME=minhphu-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev
R2_REGION=auto
